#!/usr/bin/env bash
# oe
#
# The helper commands of orchestrate-epic.
# Each subcommand lives in oe-SUBCOMMAND.sh next to this file, whose header documents it.
#
# | Subcommand | Does |
# |---|---|
# | ready | Prints the next action of every child Issue of an Epic |
# | wait | Blocks until oe ready's output changes or a timeout passes |
# | start | Starts an Owner or a Verifier for one Issue, writing the working marker in the Issue body |
# | hold | Records that an Issue waits on the person, with the reason oe ready gave, as an Issue comment |
# | question | Writes an Owner's question on the Issue, or records the person's answer to it or the person's re-run request |
# | brief | Builds an Owner's or a Verifier's brief, recording each Verifier start on its SHA |
# | verdict | Writes a Verifier's verdict on the PR head SHA it checked, posting its findings on the PR when a person must read them |
# | worktree | Creates or removes an Issue branch's worktree outside the shared checkout |
#
# An unknown or missing subcommand exits 2.
set -uo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
ready | wait | start | hold | question | brief | verdict | worktree)
  sub="$1"
  shift
  exec bash "${dir}/oe-${sub}.sh" "$@"
  ;;
*)
  cat >&2 <<'EOF'
Usage: oe ready <owner/repo> <epic-number> [--running <issue-number>]...
       oe wait <owner/repo> <epic-number> [--running <issue-number>]... [--max-agents <n>] [--timeout <seconds>] [--idle-since <epoch>]
       oe start owner <owner/repo> <issue-number> [--claim] [<reason>]
       oe start verifier <owner/repo> <issue-number>
       oe hold <owner/repo> <issue-number> <reason>
       oe question <owner/repo> <issue-number> < question
       oe question <owner/repo> <issue-number> --answer <reply>
       oe question <owner/repo> <issue-number> --rerun [<decision>]
       oe brief owner <owner/repo> <issue-number> <worktree> [<reason>]
       oe brief verifier <owner/repo> <issue-number> <worktree>
       oe verdict <owner/repo> <issue-number> <sha> success|failure < findings
       oe worktree add <issue-number> [--detach]
       oe worktree remove <issue-number>
EOF
  exit 2
  ;;
esac
