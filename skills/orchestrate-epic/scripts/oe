#!/usr/bin/env bash
# oe
#
# The helper commands of orchestrate-epic.
# Each subcommand lives in oe-SUBCOMMAND.sh next to this file, whose header documents it.
#
# | Subcommand | Does |
# |---|---|
# | ready | Prints the next action of every child Issue of an Epic |
# | wait | Blocks until oe ready's output changes, a timeout passes, or the session has idled too long |
# | claim | Creates an Issue's branch on origin and records the claim on this host |
# | attempt | Records an Owner attempt on this host before the Owner starts, and refuses one past the cap |
# | question | Writes an Owner's question on the Issue |
# | brief | Builds an Owner's or a Verifier's brief, recording each Verifier start on its SHA |
# | verdict | Writes a Verifier's verdict on the PR head SHA it checked, keeping its findings on this host |
# | records | Prints an Issue's records on this host from its latest claim on |
# | forget | Drops an Epic's records from this host once every child Issue is closed |
# | worktree | Creates or removes an Issue branch's worktree outside the shared checkout |
# | lock | Holds or releases the one session allowed per Epic on this host |
#
# An unknown or missing subcommand exits 2.
set -uo pipefail

dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${1:-}" in
ready | wait | claim | attempt | question | brief | verdict | records | forget | worktree | lock)
  sub="$1"
  shift
  exec bash "${dir}/oe-${sub}.sh" "$@"
  ;;
*)
  cat >&2 <<'EOF'
Usage: oe ready <owner/repo> <epic-number> [--running <issue-number>]...
       oe wait <owner/repo> <epic-number> [--running <issue-number>]... [--timeout <seconds>] [--idle-since <epoch>]
       oe claim <owner/repo> <issue-number>
       oe attempt <owner/repo> <issue-number>
       oe question <owner/repo> <issue-number> < question
       oe brief owner <owner/repo> <issue-number> <worktree> [<reason>]
       oe brief verifier <owner/repo> <issue-number> <worktree>
       oe verdict <owner/repo> <issue-number> <sha> success|failure < findings
       oe records <owner/repo> <issue-number>
       oe forget <owner/repo> <epic-number>
       oe worktree add <issue-number> [--detach]
       oe worktree remove <issue-number>
       oe lock acquire <owner/repo> <epic-number> [<token>]
       oe lock release <owner/repo> <epic-number> <token>
EOF
  exit 2
  ;;
esac
