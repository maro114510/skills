#!/usr/bin/env bash
# Runs the oe binary pinned in oe-manifest.tsv next to this file, and never an unverified one.
# The plugin ships no binary.
# The wrapper picks the asset for this platform and downloads it with gh release download when the cache has no valid copy.
# It checks the sha256 against the manifest, installs atomically, and execs oe with the caller's arguments.
# The cached binary is checked again before every execution.
# A mismatching cached copy is replaced from the Release, or refused when gh cannot reach it.
#
# Exit codes before oe runs, each with one verdict line on stdout
#   1  the download failed
#   8  refused, for an unsupported platform, an unusable manifest, nothing pinned, or a checksum mismatch
# After oe runs, its own exit code passes through.
#
# The cache is ${XDG_CACHE_HOME:-$HOME/.cache}/oe/<tag>/oe_<os>_<arch> in a directory only the user can write.
# Someone who can rewrite that file between the check and the exec is outside this guarantee.
#
# Written for bash 3.2, the bash macOS ships.
set -uo pipefail

EXIT_UNREADABLE=1
EXIT_REFUSED=8

# Holds the staging directory of a download in progress.
# Any exit or ending signal removes it, so an interrupted download leaves nothing behind.
staging=''
cleanup() {
  [[ -z "${staging}" ]] || rm -rf -- "${staging}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

fail() { # fail <exit code> <word> <message>
  printf '%s: oe wrapper: %s\n' "$2" "$3"
  exit "$1"
}
refuse() { fail "${EXIT_REFUSED}" refused "$1"; }

# Prints the directory holding this file with symlinks followed.
# The manifest is then found however a harness invokes the wrapper.
self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "${src}" ]]; do
    dir="$(cd -P "$(dirname "${src}")" && pwd)" || return 1
    src="$(readlink "${src}")" || return 1
    case "${src}" in
    /*) ;;
    *) src="${dir}/${src}" ;;
    esac
  done
  cd -P "$(dirname "${src}")" && pwd
}

# Prints the lowercase sha256 of a file.
sha256_of() {
  local out
  if command -v sha256sum >/dev/null 2>&1; then
    out="$(sha256sum -- "$1" 2>/dev/null)" || return 1
  elif command -v shasum >/dev/null 2>&1; then
    out="$(shasum -a 256 -- "$1" 2>/dev/null)" || return 1
  else
    return 1
  fi
  printf '%s' "${out%% *}"
}

RE_REPO='^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'
RE_TAG='^oe-v[0-9]+\.[0-9]+\.[0-9]+$'
RE_REVISION='^[0-9a-f]{40}$'
RE_SHA256='^[0-9a-f]{64}$'
ASSETS='oe_darwin_arm64 oe_darwin_amd64 oe_linux_arm64 oe_linux_amd64'

case "$(uname -s)" in
Darwin) os=darwin ;;
Linux) os=linux ;;
*) refuse "unsupported OS $(uname -s). oe ships for darwin and linux" ;;
esac
case "$(uname -m)" in
arm64 | aarch64) arch=arm64 ;;
x86_64 | amd64) arch=amd64 ;;
*) refuse "unsupported CPU $(uname -m). oe ships for arm64 and amd64" ;;
esac
asset="oe_${os}_${arch}"

here="$(self_dir)" || refuse "cannot resolve the wrapper's own location"
manifest="${here}/oe-manifest.tsv"
[[ -f "${manifest}" ]] || refuse "manifest ${manifest} is missing"

# Reads the manifest strictly, with one tab separated record per line and no unknown or repeated record.
# Anything else is refused, because a manifest that cannot be read exactly cannot vouch for bytes.
repo='' tag='' revision='' expected='' seen_assets=''
while IFS=$'\t' read -r kind f1 f2 extra || [[ -n "${kind}" ]]; do
  case "${kind}" in
  '' | '#'*) continue ;;
  esac
  [[ -z "${extra}" ]] || refuse "manifest line for '${kind}' has extra fields"
  case "${kind}" in
  repo)
    [[ -z "${repo}" ]] && [[ -z "${f2}" ]] && [[ ${f1} =~ ${RE_REPO} ]] || refuse "manifest 'repo' line is malformed or repeated"
    repo="${f1}"
    ;;
  tag)
    [[ -z "${tag}" ]] && [[ -z "${f2}" ]] && [[ ${f1} =~ ${RE_TAG} ]] || refuse "manifest 'tag' line is malformed or repeated"
    tag="${f1}"
    ;;
  revision)
    [[ -z "${revision}" ]] && [[ -z "${f2}" ]] && [[ ${f1} =~ ${RE_REVISION} ]] || refuse "manifest 'revision' line is malformed or repeated"
    revision="${f1}"
    ;;
  asset)
    case " ${ASSETS} " in
    *" ${f1} "*) ;;
    *) refuse "manifest names an unknown asset '${f1}'" ;;
    esac
    case " ${seen_assets} " in
    *" ${f1} "*) refuse "manifest names asset '${f1}' twice" ;;
    esac
    [[ ${f2} =~ ${RE_SHA256} ]] || refuse "manifest sha256 for ${f1} is malformed"
    seen_assets="${seen_assets} ${f1}"
    [[ "${f1}" != "${asset}" ]] || expected="${f2}"
    ;;
  *) refuse "manifest has an unknown record '${kind}'" ;;
  esac
done <"${manifest}"

[[ -n "${repo}" ]] || refuse "manifest names no repo"
if [[ -z "${tag}" ]] && [[ -z "${revision}" ]] && [[ -z "${seen_assets}" ]]; then
  refuse "no oe release is pinned yet. After an oe-v tag is released, run make oe-manifest TAG=<tag> and merge the PR"
fi
[[ -n "${tag}" ]] && [[ -n "${revision}" ]] || refuse "manifest pins a release without both a tag and a revision"
for name in ${ASSETS}; do
  case " ${seen_assets} " in
  *" ${name} "*) ;;
  *) refuse "manifest does not pin ${name}" ;;
  esac
done

# Succeeds only for a regular file that is not a symlink and whose bytes match the manifest.
cache_valid() {
  local got
  [[ -f "$1" ]] && [[ ! -L "$1" ]] || return 1
  got="$(sha256_of "$1")" || return 1
  [[ "${got}" = "${expected}" ]]
}

cache_base="${XDG_CACHE_HOME:-}"
if [[ -z "${cache_base}" ]]; then
  [[ -n "${HOME:-}" ]] || refuse "neither XDG_CACHE_HOME nor HOME is set, so there is no cache directory"
  cache_base="${HOME}/.cache"
fi
cache_dir="${cache_base}/oe/${tag}"
binary="${cache_dir}/${asset}"

if ! cache_valid "${binary}"; then
  if [[ -e "${binary}" ]] || [[ -L "${binary}" ]]; then
    printf 'oe wrapper: cached %s does not match the manifest; replacing it\n' "${binary}" >&2
    rm -rf -- "${binary}" || refuse "cannot remove the corrupt cached ${binary}"
  fi

  command -v gh >/dev/null 2>&1 || fail "${EXIT_UNREADABLE}" unreadable "gh is not installed, so ${asset} cannot be downloaded"
  (umask 077 && mkdir -p -- "${cache_dir}") || fail "${EXIT_UNREADABLE}" unreadable "cannot create ${cache_dir}"
  staging="$(mktemp -d "${cache_dir}/.download.XXXXXX")" || fail "${EXIT_UNREADABLE}" unreadable "cannot create a staging directory in ${cache_dir}"

  if ! gh release download "${tag}" --repo "${repo}" --pattern "${asset}" --dir "${staging}" >&2; then
    rm -rf -- "${staging}"
    fail "${EXIT_UNREADABLE}" unreadable "gh could not download ${asset} from ${repo} ${tag}"
  fi
  if ! cache_valid "${staging}/${asset}"; then
    got="$(sha256_of "${staging}/${asset}" 2>/dev/null || true)"
    rm -rf -- "${staging}"
    refuse "downloaded ${asset} does not match the manifest sha256. Expected ${expected} but got ${got:-unreadable}. Not executing it"
  fi
  chmod 755 "${staging}/${asset}" || {
    rm -rf -- "${staging}"
    refuse "cannot make ${asset} executable"
  }
  # The staging directory is beside the target, so the rename is atomic.
  mv -f -- "${staging}/${asset}" "${binary}" || {
    rm -rf -- "${staging}"
    refuse "cannot install ${asset} into ${cache_dir}"
  }
  rm -rf -- "${staging}"
  staging=''
fi

# The check that gates every execution, cached or freshly installed.
cache_valid "${binary}" || refuse "${binary} does not match the manifest sha256. Not executing it"
[[ -x "${binary}" ]] || chmod 755 "${binary}" || refuse "cannot make ${binary} executable"
trap - EXIT INT TERM HUP
exec "${binary}" "$@"
